<div class="container my-4">
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h2 class="mb-4 text-success fw-bold">Add New Product</h2>

      <%= form_with model: [:dashboard, :seller, @product], local: true, html: { multipart: true }, class: "row g-3" do |f| %>
        <% if @product.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @product.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="col-md-6">
          <%= f.label :title, "Product Title", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :title, class: "form-control custom-input", placeholder: "e.g. Wireless Mouse" %>
        </div>

        <div class="col-md-6">
          <%= f.label :price, "Price ($)", class: "form-label fw-semibold text-dark" %>
          <%= f.number_field :price, step: 0.01, class: "form-control custom-input", placeholder: "e.g. 49.99" %>
        </div>

        <div class="col-md-6">
          <%= f.label :stock, "Stock Quantity", class: "form-label fw-semibold text-dark" %>
          <%= f.number_field :stock, class: "form-control custom-input", placeholder: "e.g. 100" %>
        </div>

        <div class="col-md-6">
          <%= f.label :category_id, "Category", class: "form-label fw-semibold text-dark" %>
          <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Select Category" }, class: "form-select custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :is_active, "Status", class: "form-label fw-semibold text-dark" %>
          <%= f.select :is_active, [["Active", true], ["Inactive", false]], {}, class: "form-select custom-input" %>
        </div>

        <div class="col-12">
          <%= f.label :description, "Description", class: "form-label fw-semibold text-dark" %>
          <%= f.text_area :description, rows: 4, class: "form-control custom-input", placeholder: "Describe your product here..." %>
        </div>

        <div class="col-12">
          <%= f.label :images, "Upload Images", class: "form-label fw-semibold text-dark" %>
          <%= f.file_field :images, multiple: true, accept: "image/*", class: "form-control custom-input", id: "product-images" %>
          <div class="form-text text-muted">You can upload multiple images. Supported formats: JPG, PNG.</div>
        </div>

        <div class="col-12 d-flex flex-wrap gap-3" id="image-preview"></div>

        <div class="col-12 d-flex justify-content-end mt-3">
          <%= f.submit "Create Product", class: "btn btn-success custom-btn" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const input = document.querySelector("#product-images");
    const preview = document.querySelector("#image-preview");

    input.addEventListener("change", function () {
      preview.innerHTML = "";
      Array.from(input.files).forEach((file) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = document.createElement("img");
          img.src = e.target.result;
          img.className = "img-thumbnail";
          img.style.width = "100px";
          preview.appendChild(img);
        };
        reader.readAsDataURL(file);
      });
    });
  });
</script>

<style>
  .custom-input {
    border-radius: 10px;
    border: 1px solid #d1fae5;
    background-color: #f0fdf4;
    color: #065f46;
    transition: all 0.2s ease-in-out;
  }

  .custom-input:focus {
    border-color: #22c55e;
    box-shadow: 0 0 0 0.15rem rgba(34, 197, 94, 0.25);
    background-color: #ffffff;
    color: #065f46;
  }

  .custom-btn {
    background: linear-gradient(to right, #22c55e, #16a34a);
    border: none;
    padding: 10px 24px;
    font-weight: 600;
    border-radius: 8px;
    color: #fff;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .custom-btn:hover {
    background: linear-gradient(to right, #16a34a, #15803d);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(22, 163, 74, 0.25);
  }
</style>
