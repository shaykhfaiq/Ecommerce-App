<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-success">Products</h2>
    <%= link_to "Add New Product", new_dashboard_seller_product_path, class: "btn btn-success" %>
  </div>

  <% if @products.empty? %>
    <div class="alert alert-info">
      No products found. <%= link_to "Create one", new_dashboard_seller_product_path, class: "text-success fw-bold" %>.
    </div>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover table-bordered shadow-sm align-middle">
        <thead class="table-success text-dark">
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>SKU</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Category</th>
            <th>Status</th>
            <th class="text-center" style="width: 120px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr>
              <td>
                <% if product.images.attached? %>
                  <%= image_tag product.images.first.variant(resize_to_limit: [60, 60]), class: "rounded shadow-sm", alt: product.title %>
                <% else %>
                  <span class="text-muted">No Image</span>
                <% end %>
              </td>
              <td><%= product.title %></td>
              <td><span class="badge bg-light text-dark"><%= product.sku %></span></td>
              <td>$<%= number_with_precision(product.price, precision: 2) %></td>
              <td><%= product.stock %></td>
              <td><%= product.category&.name || "—" %></td>
              <td>
                <% if product.is_active? %>
                  <span class="badge bg-success">Active</span>
                <% else %>
                  <span class="badge bg-secondary">Inactive</span>
                <% end %>
              </td>
              <td class="text-center">
                <%= link_to edit_dashboard_seller_product_path(product), class: "btn btn-sm btn-outline-success me-2", title: "Edit" do %>
                  <i class="fas fa-edit"></i>
                <% end %>

                <%= button_to dashboard_seller_product_path(product), method: :delete,
                      data: { turbo_confirm: "Are you sure you want to delete this product?" },
                      class: "btn btn-sm btn-outline-danger", form: { class: "d-inline" } do %>
                  <i class="fas fa-trash"></i>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
