<div class="container my-4">
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h2 class="mb-4 text-success fw-bold">Edit Seller Profile</h2>

      <%= form_with(model: [:dashboard, @profile], local: true, html: { multipart: true }, class: "row g-3") do |f| %>
        <% if @profile.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @profile.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Logo Preview -->
        <div class="col-12 text-center">
          <% if @profile.logo.attached? %>
            <%= image_tag @profile.logo.variant(resize_to_limit: [140, 140]), class: "rounded-circle profile-logo mb-3", id: "logo-preview" %>
          <% else %>
            <%= image_tag "", id: "logo-preview", class: "rounded-circle profile-logo mb-3", style: "display:none;" %>
            <i class="fas fa-user-circle fa-7x text-muted" id="logo-placeholder"></i>
          <% end %>
        </div>

        <div class="col-12">
          <%= f.label :logo, "Profile Picture", class: "form-label fw-semibold text-dark" %>
          <%= f.file_field :logo, class: "form-control custom-input", accept: "image/*", onchange: "previewLogo(this)" %>
        </div>

        <!-- Fields -->
        <div class="col-md-6">
          <%= f.label :store_name, "Store Name", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :store_name, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :store_slug, "Store Slug", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :store_slug, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :business_email, "Business Email", class: "form-label fw-semibold text-dark" %>
          <%= f.email_field :business_email, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :phone_number, "Phone Number", class: "form-label fw-semibold text-dark" %>
          <%= f.telephone_field :phone_number, class: "form-control custom-input" %>
        </div>

        <div class="col-12">
          <%= f.label :address, "Address", class: "form-label fw-semibold text-dark" %>
          <%= f.text_area :address, rows: 2, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :city, "City", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :city, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :state, "State", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :state, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :country, "Country", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :country, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :postal_code, "Postal Code", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :postal_code, class: "form-control custom-input" %>
        </div>

        <div class="col-12">
          <%= f.label :description, "Description", class: "form-label fw-semibold text-dark" %>
          <%= f.text_area :description, rows: 4, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :website, "Website", class: "form-label fw-semibold text-dark" %>
          <%= f.url_field :website, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :tax_id, "Tax ID", class: "form-label fw-semibold text-dark" %>
          <%= f.text_field :tax_id, class: "form-control custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :status, "Status", class: "form-label fw-semibold text-dark" %>
          <%= f.select :status, SellerProfile.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "form-select custom-input" %>
        </div>

        <div class="col-md-6">
          <%= f.label :verified, "Verified", class: "form-label fw-semibold text-dark" %>
          <%= f.select :verified, [["Yes", true], ["No", false]], {}, class: "form-select custom-input" %>
        </div>

        <div class="col-12 d-flex justify-content-end mt-3">
          <%= f.submit "Update Profile", class: "btn btn-success custom-btn" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- ✅ CSS + Preview Script -->
<style>
  .custom-input {
    border-radius: 10px;
    border: 1px solid #d1fae5;
    background-color: #f0fdf4;
    color: #065f46;
    transition: all 0.2s ease-in-out;
  }

  .custom-input:focus {
    border-color: #22c55e;
    box-shadow: 0 0 0 0.15rem rgba(34, 197, 94, 0.25);
    background-color: #ffffff;
    color: #065f46;
  }

  .custom-btn {
    background: linear-gradient(to right, #22c55e, #16a34a);
    border: none;
    padding: 10px 24px;
    font-weight: 600;
    border-radius: 8px;
    color: #fff;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .custom-btn:hover {
    background: linear-gradient(to right, #16a34a, #15803d);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(22, 163, 74, 0.25);
  }

  .profile-logo {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid #22c55e;
    padding: 3px;
  }
</style>

<script>
  function previewLogo(input) {
    const preview = document.getElementById('logo-preview');
    const placeholder = document.getElementById('logo-placeholder');
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.src = e.target.result;
        preview.style.display = "block";
        if (placeholder) placeholder.style.display = "none";
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
